{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Review card",
  "type": "object",
  "required": [
    "id",
    "title",
    "project",
    "created",
    "what",
    "why",
    "question",
    "options",
    "media",
    "lane",
    "evidence",
    "recommendation"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "project": {
      "type": "string",
      "minLength": 1
    },
    "created": {
      "type": "string",
      "minLength": 1
    },
    "what": {
      "type": "string",
      "minLength": 1
    },
    "why": {
      "type": "string",
      "minLength": 1
    },
    "question": {
      "type": "string",
      "minLength": 1
    },
    "options": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "maxItems": 4,
      "uniqueItems": true
    },
    "media": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "context": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "lane": {
      "type": "string",
      "minLength": 1
    },
    "recommendation": {
      "type": "string"
    }
  }
}
